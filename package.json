{
  "name": "hanzi-hatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn to write Chinese characters, tones, pronunciation and meaning with spaced repetition.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "predev": "node scripts/build-data.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/build-data.mjs --if-missing",
    "build": "tsc -b && vite build",
